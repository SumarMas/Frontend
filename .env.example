# ============================================================
# Variables de entorno de referencia para SumarMas Frontend
# ============================================================
# Angular no lee archivos .env directamente.
# En su lugar, se usan archivos de environment en src/environments/.
#
# Para apuntar al gateway REMOTO (por defecto):
#   npm start
#
# Para apuntar al gateway LOCAL:
#   npm run start:local
#
# Para producción:
#   ng build --configuration=production
# ============================================================

# Gateway remoto (por defecto)
API_BASE_URL=http://sumar-mas.dynns.com:9080

# Gateway local
# API_BASE_URL=http://localhost:9080
